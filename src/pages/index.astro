---
import BaseHead from "../components/BaseHead.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { SITE_TITLE, SITE_DESCRIPTION } from "../consts";
import { getCollection } from "astro:content";
import FormattedDate from "../components/FormattedDate.astro";

const posts = (await getCollection("blog")).sort(
  (a, b) => a.data.pubDate.valueOf() - b.data.pubDate.valueOf()
);
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
  </head>
  <body>
    <Header title={SITE_TITLE} />
    <main>
      <h1>Welcome to the Thomas Archive!</h1>
      <figure>
        <img src="/bermuda-coat-of-arms.svg" width="300px" />
        <figcaption>
          The coat of arms of Bermuda, which features the 1609 wreck of the <i
            >Sea Venture</i
          >. According to legend, a John Thomas was on board.
        </figcaption>
      </figure>
      <p>
        This site contains information about the Thomas family, who moved to San
        Augustine in the early 19th century. If you are interested in contacting
        me about the things you find on this page, feel free to <a
          href="mailto:hi@samthomas.io">email me</a
        >.
      </p>
      <section>
        <ul>
          {
            posts.map((post) => (
              <li>
                <FormattedDate date={post.data.pubDate} />
                <a href={`/${post.slug}/`}>{post.data.title}</a>
              </li>
            ))
          }
        </ul>
      </section>
    </main>
    <Footer />
  </body>
</html>
